<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    tools:context=".Kalender">

    <!-- Bottom Navigation (wie Home) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@android:color/white"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/menu_user" />

    <!-- Scroll Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp">

            <!-- Blauer Header -->
            <View
                android:id="@+id/headerBlue"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_header_blue" />

            <!-- Optional: Back Icon (wenn du nicht willst -> visibility="gone") -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-140dp"
                android:contentDescription="back"
                android:src="@drawable/asset_arrow_back"
                android:visibility="invisible" />

            <!-- Titel -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginTop="-24dp"
                android:text="Kalender"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Weißer Content Bereich -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp">

                <!-- Kalender Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="8dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Monat + Pfeile -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">



                            <TextView
                                android:id="@+id/tvMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dezember 2025"
                                android:textColor="#263238"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />


                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="8dp" />

                        <!-- CalendarView (Standard Android) -->
                        <CalendarView
                            android:id="@+id/calendarView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:firstDayOfWeek="2"
                            android:showWeekNumber="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <!-- Überschrift: Medikation am ... -->
                <TextView
                    android:id="@+id/tvMedicationDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medikation am 10. Dezember"
                    android:textColor="#2B3A4A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- Einnahme Card 1 (Eingenommen) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDose1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@android:color/white">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <!-- Grüner Rand links -->
                        <View
                            android:id="@+id/leftBar1"
                            android:layout_width="4dp"
                            android:layout_height="0dp"
                            android:background="#2ECC71"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvTime1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:00"
                            android:textColor="#2B3A4A"
                            android:textSize="12sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/leftBar1"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvMedName1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Aspirin 100mg"
                            android:textColor="#263238"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/leftBar1"
                            app:layout_constraintTop_toBottomOf="@id/tvTime1"
                            app:layout_constraintEnd_toStartOf="@id/chipDone1" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDone1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Eingenommen"
                            android:textColor="#1E8E3E"
                            app:chipBackgroundColor="#DFF7E8"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivHint1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="hint"
                            android:src="@drawable/asset_pill"
                            app:layout_constraintStart_toEndOf="@id/leftBar1"
                            app:layout_constraintTop_toBottomOf="@id/tvMedName1" />

                        <TextView
                            android:id="@+id/tvHint1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:text="Nach dem Essen"
                            android:textColor="#6B7A8C"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@id/ivHint1"
                            app:layout_constraintTop_toBottomOf="@id/tvMedName1"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Einnahme Card 2 (Eingenommen) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDose2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@android:color/white">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <View
                            android:id="@+id/leftBar2"
                            android:layout_width="4dp"
                            android:layout_height="0dp"
                            android:background="#2ECC71"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvTime2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12:00"
                            android:textColor="#2B3A4A"
                            android:textSize="12sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/leftBar2"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvMedName2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Metformin 500mg"
                            android:textColor="#263238"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/leftBar2"
                            app:layout_constraintTop_toBottomOf="@id/tvTime2"
                            app:layout_constraintEnd_toStartOf="@id/chipDone2" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDone2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Eingenommen"
                            android:textColor="#1E8E3E"
                            app:chipBackgroundColor="#DFF7E8"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivHint2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="hint"
                            android:src="@drawable/asset_pill"
                            app:layout_constraintStart_toEndOf="@id/leftBar2"
                            app:layout_constraintTop_toBottomOf="@id/tvMedName2" />

                        <TextView
                            android:id="@+id/tvHint2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:text="Vor dem Essen"
                            android:textColor="#6B7A8C"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@id/ivHint2"
                            app:layout_constraintTop_toBottomOf="@id/tvMedName2"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Einnahme Card 3 (Geplant) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDose3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@android:color/white">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <View
                            android:id="@+id/leftBar3"
                            android:layout_width="4dp"
                            android:layout_height="0dp"
                            android:background="#B0B8C3"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvTime3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14:30"
                            android:textColor="#2B3A4A"
                            android:textSize="12sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/leftBar3"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvMedName3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Aspirin 100mg"
                            android:textColor="#263238"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/leftBar3"
                            app:layout_constraintTop_toBottomOf="@id/tvTime3"
                            app:layout_constraintEnd_toStartOf="@id/chipPlan3" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPlan3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Geplant"
                            android:textColor="#5F6B7A"
                            app:chipBackgroundColor="#EEF1F5"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivHint3"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="hint"
                            android:src="@drawable/asset_pill"
                            app:layout_constraintStart_toEndOf="@id/leftBar3"
                            app:layout_constraintTop_toBottomOf="@id/tvMedName3" />

                        <TextView
                            android:id="@+id/tvHint3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:text="Nach dem Essen"
                            android:textColor="#6B7A8C"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@id/ivHint3"
                            app:layout_constraintTop_toBottomOf="@id/tvMedName3"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- Abstand unten -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="6dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
