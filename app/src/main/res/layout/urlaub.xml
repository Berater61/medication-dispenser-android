<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    tools:context=".Fenster_Urlaubsmodus">

    <!-- Blauer Header -->
    <View
        android:id="@+id/headerBlue"
        android:layout_width="0dp"
        android:layout_height="210dp"
        android:background="@drawable/bg_header_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Zurück (Icon setzt du selber) -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="56dp"
        android:contentDescription="back"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/asset_arrow_back"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Titel -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Urlaubsmodus"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"/>

    <!-- Flugzeug Icon (setzt du selber) -->
    <ImageView
        android:id="@+id/ivPlane"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:contentDescription="plane"
        android:src="@drawable/asset_flight"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvSubtitleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reise planen"
        android:textColor="#EAF2FF"
        android:textSize="12sp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/ivPlane"
        app:layout_constraintTop_toTopOf="@id/ivPlane"/>

    <TextView
        android:id="@+id/tvSubtitleBig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Urlaubspakete vorbereiten"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toEndOf="@id/ivPlane"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitleSmall"/>

    <!-- Scroll Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollVacation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerBlue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Card: Reisedauer -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-40dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Kopfzeile -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            app:cardBackgroundColor="#EAF2FF"
                            app:cardCornerRadius="17dp"
                            app:cardElevation="0dp">

                            <!-- Icon setzt du selber -->
                            <ImageView
                                android:id="@+id/ivCalendar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="calendar"/>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Reisedauer auswählen"
                            android:textColor="#263238"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"/>

                    <!-- Abreise -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abreisedatum"
                        android:textColor="#6B7A8C"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etAbreise"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/thm_input_light"
                        android:hint="tt.mm.jjjj"
                        android:inputType="date"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#263238"
                        android:textColorHint="#6B7A8C"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"/>

                    <!-- Rückreise -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rückreisedatum"
                        android:textColor="#6B7A8C"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etRueckreise"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/thm_input_light"
                        android:hint="tt.mm.jjjj"
                        android:inputType="date"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#263238"
                        android:textColorHint="#6B7A8C"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Zeit verschieben (ohne Zeitzone) -->

            <!-- Button (blau, gleiche Ressourcen wie deine anderen Buttons) -->
            <Button
                android:id="@+id/btnWeiter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_blue_gradient"
                app:backgroundTint="@null"
                android:text="Blister Medikamente"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
