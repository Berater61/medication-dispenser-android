<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    tools:context=".Fenster_Allergien">

    <!-- Blauer Header -->
    <View
        android:id="@+id/headerBlue"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:background="@drawable/bg_header_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Zurück Pfeil -->
    <ImageView
        android:id="@+id/btnBack_al"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="56dp"
        android:contentDescription="back"
        android:src="@drawable/asset_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Titel -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Allergien"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/btnBack_al"
        app:layout_constraintTop_toTopOf="@id/btnBack_al"
        app:layout_constraintBottom_toBottomOf="@id/btnBack_al"/>

    <!-- Scrollbarer Inhalt -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/headerBlue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Hinweis -->
                    <TextView
                        android:id="@+id/tvHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trage deine Allergien ein (du kannst später erweitern)."
                        android:textColor="#6B7A8C"
                        android:textSize="12sp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"/>

                    <!-- Allergie 1 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allergie 1"
                        android:textColor="#6B7A8C"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/etAllergy1"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:hint="z.B. Penicillin"
                        android:background="@drawable/thm_input_light"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#263238"
                        android:textColorHint="#6B7A8C"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"/>

                    <!-- Allergie 2 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allergie 2"
                        android:textColor="#6B7A8C"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/etAllergy2"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:hint="z.B. Nüsse"
                        android:background="@drawable/thm_input_light"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#263238"
                        android:textColorHint="#6B7A8C"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"/>

                    <!-- Allergie 3 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allergie 3"
                        android:textColor="#6B7A8C"
                        android:textSize="12sp"/>

                    <EditText
                        android:id="@+id/etAllergy3"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:hint="z.B. Pollen"
                        android:background="@drawable/thm_input_light"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#263238"
                        android:textColorHint="#6B7A8C"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"/>

            <!-- Speichern Button -->
            <Button
                android:id="@+id/btn_save_al"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_primary_blue"
                android:text="SPEICHERN"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
