<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registrierung"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    tools:context=".Registrierung">

    <!-- Blauer Header -->
    <View
        android:id="@+id/headerBlue"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_header_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Titel -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medikamenten-Spender"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Untertitel -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrierung"
        android:textColor="#EAF2FF"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="@id/tvTitle"/>

    <!-- Registrierungs-Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRegister"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="-60dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@id/headerBlue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Scrollbar in der Card -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Vorname -->
                <EditText
                    android:id="@+id/vorname"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="@string/vorname"
                    android:inputType="textPersonName"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Nachname -->
                <EditText
                    android:id="@+id/nachname"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="@string/nachname"
                    android:inputType="textPersonName"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Geburtsdatum -->
                <EditText
                    android:id="@+id/geburtsdatum"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="@string/geburtsdatum"
                    android:inputType="date"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Adresse -->
                <EditText
                    android:id="@+id/adresse"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="@string/adresse"
                    android:inputType="textPostalAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Telefonnummer -->
                <EditText
                    android:id="@+id/telefonnummer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="@string/telefonnummer"
                    android:inputType="phone"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Versicherungsnummer -->
                <EditText
                    android:id="@+id/versicherungsnummer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="@string/versicherungsnummer"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Email -->
                <EditText
                    android:id="@+id/username_register"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="E-Mail"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Passwort -->
                <EditText
                    android:id="@+id/passwort_register"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="Passwort"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Passwort wiederholen -->
                <EditText
                    android:id="@+id/passwort_register1"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/thm_input_light"
                    android:hint="@string/passwort_wiederholen"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#263238"
                    android:textColorHint="#6B7A8C"/>

                <View android:layout_width="match_parent" android:layout_height="18dp"/>

                <!-- Button blau mit Verlauf -->
                <Button
                    android:id="@+id/registrierung_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_blue_gradient"
                    app:backgroundTint="@null"
                    android:text="REGISTRIEREN"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
